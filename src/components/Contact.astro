---
import { Mail, Phone, MapPin, Send } from '@lucide/astro';
import { useTranslations, defaultLang, type Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const f = t.contact.form;
---

<section class="section contact-section" id="contacto">
  <div class="container">
    <div class="contact-grid">
      <!-- Info Column -->
      <div class="contact-info-col reveal">
        <span class="section-tag">{t.contact.tag}</span>
        <h2 class="contact-title">{t.contact.titleBefore} <span class="accent-title">{t.contact.titleAccent}</span>{t.contact.titleAfter}</h2>
        <p class="contact-desc">
          {t.contact.description}
        </p>

        <div class="contact-methods">
          <div class="contact-method-item">
            <div class="method-icon-box">
              <MapPin class="method-icon" />
            </div>
            <div class="method-text">
              <h3>{t.contact.methods.locationTitle}</h3>
              <p>{t.contact.methods.locationLine1}</p>
              <p>{t.contact.methods.locationLine2}</p>
            </div>
          </div>

          <div class="contact-method-item">
            <div class="method-icon-box">
              <Phone class="method-icon" />
            </div>
            <div class="method-text">
              <h3>{t.contact.methods.phoneTitle}</h3>
              <p><a href="tel:+593987889700">+593 987 889 700</a></p>
            </div>
          </div>

          <div class="contact-method-item">
            <div class="method-icon-box">
              <Mail class="method-icon" />
            </div>
            <div class="method-text">
              <h3>{t.contact.methods.emailTitle}</h3>
              <p><a href="mailto:gerencia@greemets.com">gerencia@greemets.com</a></p>
            </div>
          </div>
        </div>
      </div>

      <!-- Form Column -->
      <div class="contact-form-col reveal" style="transition-delay: 0.2s;">
        <form
          class="contact-form glass"
          id="contact-form-el"
          novalidate
          data-toast-validation-error={f.toastValidationError}
          data-toast-success={f.toastSuccess}
          data-toast-generic-error={f.toastGenericError}
          data-submitting-text={f.submitting}
          data-payload-name={f.payloadName}
          data-payload-company={f.payloadCompany}
          data-payload-phone={f.payloadPhone}
          data-payload-message={f.payloadMessage}
        >
          <!-- Formspree Config -->
          <input type="hidden" name="subject" value={f.subjectHidden} />

          <div class="form-group">
            <label for="form-name">{f.nameLabel}</label>
            <input type="text" id="form-name" name="name" required placeholder={f.namePlaceholder} />
            <span class="error-msg" id="error-name">{f.nameError}</span>
          </div>

          <div class="form-group">
            <label for="form-company">{f.companyLabel}</label>
            <input type="text" id="form-company" name="company" required placeholder={f.companyPlaceholder} />
            <span class="error-msg" id="error-company">{f.companyError}</span>
          </div>

          <div class="form-grid">
            <div class="form-group">
              <label for="form-email">{f.emailLabel}</label>
              <input type="email" id="form-email" name="email" required placeholder={f.emailPlaceholder} />
              <span class="error-msg" id="error-email">{f.emailError}</span>
            </div>

            <div class="form-group">
              <label for="form-phone">{f.phoneLabel}</label>
              <div class="phone-input-wrapper">
                <span class="phone-prefix">+593</span>
                <input type="tel" id="form-phone" name="phone" required placeholder={f.phonePlaceholder} />
              </div>
              <span class="error-msg" id="error-phone">{f.phoneError}</span>
            </div>
          </div>

          <div class="form-group">
            <label for="form-message">{f.messageLabel}</label>
            <textarea id="form-message" name="message" rows="5" required placeholder={f.messagePlaceholder}></textarea>
            <span class="error-msg" id="error-message">{f.messageError}</span>
          </div>

          <button type="submit" class="btn btn-primary form-submit-btn">
            {f.submit}
            <Send class="btn-icon" />
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    background-color: var(--cream);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-lg);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .contact-grid {
      grid-template-columns: 4.5fr 5.5fr;
      gap: var(--spacing-xl);
    }
  }

  .contact-title {
    margin-bottom: var(--spacing-md);
  }

  .accent-title {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--forest);
    font-weight: 400;
  }

  .contact-desc {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: var(--spacing-lg);
  }

  .contact-methods {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .contact-method-item {
    display: flex;
    gap: var(--spacing-sm);
    align-items: flex-start;
  }

  .method-icon-box {
    width: 2.8rem;
    height: 2.8rem;
    border-radius: var(--radius-sm);
    background-color: var(--sage-light);
    color: var(--forest);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  :global(.method-icon) {
    width: 1.4rem;
    height: 1.4rem;
  }

  .method-text h3 {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 700;
    color: var(--forest-deep);
    margin-bottom: 0.2rem;
  }

  .method-text p {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin-bottom: 0;
    line-height: 1.4;
  }

  .method-text a:hover {
    color: var(--forest);
    text-decoration: underline;
  }

  /* Form Styling */
  .contact-form {
    padding: 2rem 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--bone);
    border: 1px solid var(--sand);
    box-shadow: var(--shadow-md);
  }

  @media (min-width: 768px) {
    .contact-form {
      padding: 2.5rem;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  @media (min-width: 768px) {
    .form-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-sm);
    }
  }

  label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--forest-deep);
  }

  input[type="text"],
  input[type="email"],
  input[type="tel"],
  textarea {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    padding: 0.8rem 1rem;
    border: 1.5px solid var(--sand);
    border-radius: var(--radius-sm);
    background-color: var(--bone);
    color: var(--text-dark);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
    outline: none;
    width: 100%;
  }

  input:focus,
  textarea:focus {
    border-color: var(--forest);
    box-shadow: 0 0 0 3px oklch(35% 0.07 162 / 12%);
  }

  /* Phone input with country code block */
  .phone-input-wrapper {
    display: flex;
    align-items: center;
    border: 1.5px solid var(--sand);
    border-radius: var(--radius-sm);
    background-color: var(--bone);
    overflow: hidden;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .phone-input-wrapper:focus-within {
    border-color: var(--forest);
    box-shadow: 0 0 0 3px oklch(35% 0.07 162 / 12%);
  }

  .phone-prefix {
    background-color: oklch(0% 0 0 / 4%);
    padding: 0.8rem 0.75rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-muted);
    border-right: 1.5px solid var(--sand);
  }

  .phone-input-wrapper input {
    border: none;
    padding: 0.8rem 1rem;
  }

  .phone-input-wrapper input:focus {
    box-shadow: none;
  }

  /* Error messages */
  .error-msg {
    font-size: 0.78rem;
    color: var(--error);
    display: none;
    margin-top: -0.2rem;
  }

  input.invalid,
  textarea.invalid,
  .phone-input-wrapper.invalid {
    border-color: var(--error);
  }

  input.invalid + .error-msg,
  textarea.invalid + .error-msg,
  .phone-input-wrapper.invalid + .error-msg {
    display: block;
  }

  .form-submit-btn {
    width: 100%;
    margin-top: 0.5rem;
  }

  :global(.btn-icon) {
    width: 1.1rem;
    height: 1.1rem;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contact-form-el') as HTMLFormElement | null;
    if (!form) return;

    const nameInput = document.getElementById('form-name') as HTMLInputElement;
    const companyInput = document.getElementById('form-company') as HTMLInputElement;
    const emailInput = document.getElementById('form-email') as HTMLInputElement;
    const phoneInput = document.getElementById('form-phone') as HTMLInputElement;
    const phoneWrapper = phoneInput.closest('.phone-input-wrapper');
    const messageInput = document.getElementById('form-message') as HTMLTextAreaElement;

    // Standard fields list for easy loops
    const fields = [
      { el: nameInput, errorId: 'error-name', validator: (v: string) => v.trim() !== '' },
      { el: companyInput, errorId: 'error-company', validator: (v: string) => v.trim() !== '' },
      { el: emailInput, errorId: 'error-email', validator: (v: string) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v) },
      { el: messageInput, errorId: 'error-message', validator: (v: string) => v.trim() !== '' },
    ];

    // Phone validation custom
    const validatePhone = (value: string) => {
      // Ecuador cellular: 9XXXXXXXX (9 digits), fixed: 2XXXXXXX to 7XXXXXXX (8 digits)
      const cleaned = value.replace(/\s+/g, '');
      return /^[9]\d{8}$/.test(cleaned) || /^[2-7]\d{7}$/.test(cleaned);
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      let isValid = true;

      // 1. Validate normal fields
      fields.forEach(field => {
        const value = field.el.value;
        const fieldIsValid = field.validator(value);
        
        if (!fieldIsValid) {
          field.el.classList.add('invalid');
          isValid = false;
        } else {
          field.el.classList.remove('invalid');
        }
      });

      // 2. Validate phone field
      if (!validatePhone(phoneInput.value)) {
        phoneWrapper?.classList.add('invalid');
        const phoneError = document.getElementById('error-phone');
        if (phoneError) phoneError.style.display = 'block';
        isValid = false;
      } else {
        phoneWrapper?.classList.remove('invalid');
        const phoneError = document.getElementById('error-phone');
        if (phoneError) phoneError.style.display = 'none';
      }

      if (!isValid) {
        window.showToast(form.dataset.toastValidationError || 'Please fill in all required fields correctly.', 'error');
        return;
      }

      // Submit logic
      const submitBtn = form.querySelector('.form-submit-btn') as HTMLButtonElement;
      const originalBtnHtml = submitBtn.innerHTML;
      submitBtn.disabled = true;
      submitBtn.innerHTML = form.dataset.submittingText || 'Sending...';

      // Construir payload para Formspree (email y mensaje concatenado)
      const formspreeData = new FormData();
      formspreeData.append('email', emailInput.value);

      const labelName = form.dataset.payloadName || 'Name';
      const labelCompany = form.dataset.payloadCompany || 'Company';
      const labelPhone = form.dataset.payloadPhone || 'Phone';
      const labelMessage = form.dataset.payloadMessage || 'Original message';

      const combinedMessage = `${labelName}: ${nameInput.value}
${labelCompany}: ${companyInput.value}
${labelPhone}: +593 ${phoneInput.value}

${labelMessage}:
${messageInput.value}`;

      formspreeData.append('message', combinedMessage);

      try {
        // Enviar a Formspree
        const response = await fetch('https://formspree.io/f/xwleljqq', {
          method: 'POST',
          body: formspreeData,
          headers: {
            'Accept': 'application/json'
          }
        });
        
        if (response.ok) {
          window.showToast(form.dataset.toastSuccess || 'Message sent successfully!', 'success');
          form.reset();
        } else {
          const data = await response.json();
          if (Object.hasOwn(data, 'errors')) {
            throw new Error(data.errors.map((error: any) => error.message).join(", "));
          } else {
            throw new Error(form.dataset.toastGenericError || 'Error submitting the form');
          }
        }
      } catch (err: any) {
        console.error(err);
        window.showToast(err.message || form.dataset.toastGenericError || 'There was an error submitting the form. Please try again.', 'error');
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalBtnHtml;
      }
    });

    // Remove invalid outline on input focus / keyup
    fields.forEach(field => {
      field.el.addEventListener('input', () => {
        if (field.validator(field.el.value)) {
          field.el.classList.remove('invalid');
        }
      });
    });

    phoneInput.addEventListener('input', () => {
      if (validatePhone(phoneInput.value)) {
        phoneWrapper?.classList.remove('invalid');
        const phoneError = document.getElementById('error-phone');
        if (phoneError) phoneError.style.display = 'none';
      }
    });
  });
</script>
